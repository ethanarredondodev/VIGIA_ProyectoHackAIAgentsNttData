# Copia este archivo como .env (docker compose lo lee solo). Todo es opcional en local.

# Claude: resume incidentes (claude-sonnet-5-5) y redacta la explicacion al supervisor.
# Sin clave, Vigía usa textos deterministas de respaldo. La decision nunca depende del LLM.
ANTHROPIC_API_KEY=

# true = vigia-ptw usa los mocks de contracts/mocks en lugar de los agentes reales.
MOCK_MODE=false

# Origenes del front autorizados por CORS en vigia-ptw (separados por coma).
WEB_ORIGIN=http://localhost:3000,http://localhost:5173

# Langfuse (trazas del grafo). Se activa solo si ambas claves existen.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Google Sheets publicados como CSV (Archivo > Compartir > Publicar en la web > CSV).
# Vacias = se usan las filas de ejemplo de data/sheets/. Se recargan cada 5 minutos.
SHEETS_LIMITES_AREA_URL=
SHEETS_CONTROLES_IPERC_URL=
SHEETS_REGLAS_ZONA_CLINICA_URL=

# Registry oficial de NANDA (projnanda/adapter). Ejemplo: https://chat.nanda-registry.com:6900
NANDA_OFICIAL_URL=

# NANDA_EMISORES, AGENT_CREDENCIAL, AGENT_ED25519_KEY y CLINICA_CLAVE no van aqui: en local los
# agentes usan claves y credenciales de desarrollo, y en Cloud Run las genera scripts/deploy.sh.
